PORT=4000
# Comma-separated allowed origins (e.g. http://localhost:5173,https://ai-medical-assistance-frontend.vercel.app)
CLIENT_ORIGIN=http://localhost:5173,https://ai-medical-assistance-frontend.vercel.app
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/carely?retryWrites=true&w=majority
# Set COOKIE_SECURE=true when deployed with HTTPS
COOKIE_SECURE=false
